# Shared
NODE_ENV=development

# API
API_PORT=3000
DATABASE_URL=postgresql://eventos:eventos@localhost:5433/eventos?schema=public
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-jwt-secret-dev
TICKET_HMAC_SECRET=change-me-ticket-hmac-dev
# Access Token v4 (JWT / Bearer, começa com eyJ) ou API Key v3 (32 hex)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org
CORS_ORIGIN=http://localhost:5173

# Web (em produção o build usa fetch relativo /api se VITE_API_URL estiver vazio)
VITE_API_URL=http://localhost:3000
